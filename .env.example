# =============================================================================
# DEV AGENTS CONFIGURATION
# =============================================================================
# Complete environment configuration for the DevAgents project
# Copy this file to .env and configure the appropriate values

# -----------------------------------------------------------------------------
# AVATAR & BRANDING
# -----------------------------------------------------------------------------
AVATAR_FULL_NAME=DevAgents
AVATAR_SHORT_NAME=DevAgents

# -----------------------------------------------------------------------------
# DEBUGGING & LOGGING
# -----------------------------------------------------------------------------
# Enable console logging for debugging (set to 1 to enable)
DEV_AGENTS_CONSOLE_LOGGING=

# Dynaconf environment mode (development, testing, production)
DYNACONF_ENV=development

# -----------------------------------------------------------------------------
# CORE SYSTEM SETTINGS
# -----------------------------------------------------------------------------
# Core application settings
CORE_LOG_DIR=./data/logs
CORE_STORAGE_FILE_DIR=./data/storage

# -----------------------------------------------------------------------------
# GIT REPOSITORY SETTINGS
# -----------------------------------------------------------------------------
# Full path to your git cloned repository
GIT_REPO_PATH=

# Automatic git pull settings
GIT_AUTOPULL=false
GIT_PULL_INTERVAL_SECONDS=120

# -----------------------------------------------------------------------------
# LLM PROVIDER CONFIGURATION - CONFIGURE AT LEAST ONE
# -----------------------------------------------------------------------------

# AWS Bedrock
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Pydantic AI Model Configuration
# See https://ai.pydantic.dev/models/ for available models
LLM_MODEL_SMALL=anthropic:claude-haiku-4-5
LLM_MODEL_LARGE=anthropic:claude-sonnet-5

# -----------------------------------------------------------------------------
# DEVOPS INTEGRATIONS - CONFIGURE ONE OR MORE
# -----------------------------------------------------------------------------

# Azure DevOps
AZURE_URL=https://dev.azure.com
AZURE_DEVOPS_ORGANIZATION=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_REPOID=
AZURE_DEVOPS_MOCK=false
#DEVOPS_ALLOW_INSECURE_CLONE_URL=false   # Dev only: allow http:// clone URL (host must still match AZURE_URL)

# GitLab Integration
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=
GITLAB_TOKEN=
GITLAB_MOCK=false
#GITLAB_ALLOW_INSECURE_CLONE_URL=false   # Dev only: allow http:// clone URL (host must still match GITLAB_API_URL)

# GitHub Integration
GITHUB_API_URL=https://api.github.com
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_MOCK=false
#GITHUB_ALLOW_INSECURE_CLONE_URL=false   # Dev only: allow http:// clone URL (host must still match GITHUB_API_URL)

# Jira Integration
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_MOCK=false

# -----------------------------------------------------------------------------
# INTERFACE INTEGRATIONS
# -----------------------------------------------------------------------------

# Slack Bot Configuration
# See https://api.slack.com/apps/ and manifest.json for setup instructions
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_PROCESSING_TIMEOUT=6000

# Shared HTTP Server Configuration (hosts AGUI + OpenAI endpoints)
#HTTP_HOST=0.0.0.0
#HTTP_PORT=8000
#HTTP_CORS_ORIGINS=          # Comma-separated origins or "*" (empty = no CORS)

# AGUI Web Interface Configuration
#AGUI_ENABLED=false
#AGUI_API_KEYS=             # Comma-separated Bearer tokens; required when AGUI_ENABLED=true
#AGUI_ALLOW_UNAUTHENTICATED=false  # Explicit opt-in to run without keys (unsafe outside a trusted network)
#AGUI_DEFAULT_TIMEOUT=300
#AGUI_DEFAULT_AGENT_TYPE=gitchatbot
#AGUI_MAX_MESSAGE_LENGTH=10000

# OpenAI-Compatible API Configuration
#OPENAI_ENTRYPOINT_ENABLED=false
#OPENAI_DEFAULT_TIMEOUT=300
#OPENAI_DEFAULT_AGENT_TYPE=gitchatbot
#OPENAI_API_KEYS=           # Comma-separated Bearer tokens; required when OPENAI_ENTRYPOINT_ENABLED=true
#OPENAI_ALLOW_UNAUTHENTICATED=false  # Explicit opt-in to run without keys (unsafe outside a trusted network)
#OPENAI_MODEL_NAME=dev-agents       # Model id advertised by /v1/models
#OPENAI_STREAMING_ENABLED=true      # false: stream requests fall back to single JSON response
#OPENAI_THINKING_ENABLED=true       # false: suppress reasoning_content (status) chunks while streaming

# CLI Configuration
CLI_DEFAULT_AGENT_TYPE=gitchatbot

# -----------------------------------------------------------------------------
# NON-SLACK PLATFORM SERVICES (Email / Mattermost / Telegram)
# -----------------------------------------------------------------------------
# Each platform exposes the agent to a public messaging surface. It must be
# opted into explicitly: <NAME>_ENABLED=true AND credentials present. Without
# an allowlist (*_ALLOWED_USERS) every user on that platform can drive the
# agent, so set allowlists for any non-trivial deployment.

# Telegram — group chats default to mention-only
#TELEGRAM_ENABLED=false
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_ALLOWED_USERS=            # Comma-separated user IDs (empty = everyone)
#TELEGRAM_REQUIRE_MENTION=true      # Require @mention in groups (default: true)
#TELEGRAM_FREE_RESPONSE_CHATS=      # Chat IDs that bypass the mention requirement

# Mattermost — https:// is required (token is sent over the connection)
#MATTERMOST_ENABLED=false
#MATTERMOST_URL=
#MATTERMOST_TOKEN=
#MATTERMOST_ALLOW_INSECURE=false    # Allow plaintext http:// URL (local dev only)
#MATTERMOST_ALLOWED_USERS=          # Comma-separated user IDs (empty = everyone)
#MATTERMOST_REQUIRE_MENTION=true    # Require @mention in channels (default: true)
#MATTERMOST_FREE_RESPONSE_CHANNELS= # Channel IDs that bypass the mention requirement
#MATTERMOST_REPLY_MODE=off          # "thread" to nest replies

# Email — all four IMAP/SMTP vars required
#EMAIL_ENABLED=false
#EMAIL_ADDRESS=
#EMAIL_PASSWORD=
#EMAIL_IMAP_HOST=
#EMAIL_SMTP_HOST=
#EMAIL_IMAP_PORT=993
#EMAIL_SMTP_PORT=587
#EMAIL_POLL_INTERVAL=15
#EMAIL_ALLOWED_USERS=               # Comma-separated sender addresses (empty = everyone)
#EMAIL_VERIFY_DKIM=true             # Require a valid, From-aligned DKIM signature.
                                    # false only if senders are authenticated upstream —
                                    # From: is forgeable, so the allowlist alone proves nothing.
                                    # Needs the [email] extra (dkimpy).

# -----------------------------------------------------------------------------
# AGENT & SUBAGENT CONFIGURATIONS
# -----------------------------------------------------------------------------

# Test Plan Agent
TEST_PLAN_MAX_FILES=200

# Changelog Agent
CHANGELOG_MAX_FILES=200

# -----------------------------------------------------------------------------
# NATS INTEGRATION
# -----------------------------------------------------------------------------
# NATS messaging system configuration
NATS_SERVER_URL=
NATS_JOB_ID=
NATS_USER=
NATS_PASSWORD=
NATS_CA_CERT_PATH=
NATS_SUBJECT_JOB_DATA=jobs
NATS_SUBJECT_JOB_UPDATES=jobupdates

